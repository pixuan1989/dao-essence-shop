{
  "framework": null,
  "buildCommand": "node build-blog.js",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/auth", "destination": "/api/auth" },
    { "source": "/callback", "destination": "/api/callback" }
  ],
  "routes": [
    { "src": "/contact(.*)", "status": 410 },
    { "src": "/blog/learn-bazi-free-course-guide", "status": 410 },
    { "src": "/zh/blog/learn-bazi-free-course-guide", "status": 410 }
  ],
  "headers": [
    {
      "source": "/js/pageview.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/zodiac/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog/daily-horoscope", "destination": "/blog/zodiac-horoscope", "permanent": true },
    { "source": "/blog/lucky-tips", "destination": "/blog/feng-shui", "permanent": true },
    { "source": "/zh/blog/daily-horoscope", "destination": "/zh/blog/zodiac-horoscope", "permanent": true },
    { "source": "/zh/blog/lucky-tips", "destination": "/zh/blog/feng-shui", "permanent": true },
    {
      "source": "/bazi-calculator",
      "destination": "/bazi-form",
      "permanent": true
    },
    {
      "source": "/zh/bazi-calculator",
      "destination": "/zh/bazi-form",
      "permanent": true
    },
    {
      "source": "/zh/culture",
      "destination": "/culture",
      "permanent": true
    },
    {
      "source": "/zh/destiny",
      "destination": "/destiny",
      "permanent": true
    },
    {
      "source": "/zh/favorable-element",
      "destination": "/favorable-element",
      "permanent": true
    },
    {
      "source": "/zh/five-elements-test",
      "destination": "/five-elements-test",
      "permanent": true
    },
    {
      "source": "/zh/guide",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/zh/privacy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/zh/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/zh/shop",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/zh/learn-bazi",
      "destination": "/learn-bazi",
      "permanent": true
    },
    {
      "source": "/zh/soulmate-calculator",
      "destination": "/soulmate-calculator",
      "permanent": true
    },
    {
      "source": "/zh/almanac",
      "destination": "/almanac",
      "permanent": true
    },
    {
      "source": "/zh/bazi-form",
      "destination": "/bazi-form",
      "permanent": true
    },
    {
      "source": "/zh/terms",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/(.+)\\.html",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://www.daoessentia.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "daoessence-shop.vercel.app"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://www.daoessentia.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "daoessence.com"
        }
      ]
    }
  ]
}
