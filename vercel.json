{
  "framework": null,
  "buildCommand": "node build-blog.js",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/api/auth"
    },
    {
      "source": "/callback",
      "destination": "/api/callback"
    },
    {
      "source": "/zh/wallpaper/:id",
      "destination": "/wallpaper/:id/index.zh"
    },
    {
      "source": "/wallpaper/:slug/js/i18n-switcher.js",
      "destination": "/js/i18n-switcher.js"
    }
  ],
  "routes": [
    {
      "src": "/contact(.*)",
      "status": 410
    },
    {
      "src": "/blog/learn-bazi-free-course-guide",
      "status": 410
    },
    {
      "src": "/zh/blog/learn-bazi-free-course-guide",
      "status": 410
    },
    {
      "src": "/blog/taoist-meditation-guide",
      "status": 410
    },
    {
      "src": "/blog/taoist-meditation-guide.html",
      "status": 410
    },
    {
      "src": "/life-path",
      "status": 410
    },
    {
      "src": "/guid",
      "status": 410
    },
    {
      "src": "/destiny",
      "status": 410
    },
    {
      "src": "/zh/destiny",
      "status": 410
    },
    {
      "src": "/blog/elon-musk-bazi-yang-wood-day-master-decoded",
      "status": 410
    },
    {
      "src": "/zh/learn-bazi/luck-pillars",
      "status": 410
    }
  ],
  "headers": [
    {
      "source": "/js/pageview.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/zodiac/((?!js/|css/|images/|img/).*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/wallpaper-detail",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/wallpaper",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/wallpaper.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/wallpaper/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/zh/wallpaper/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/wallpapers\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
